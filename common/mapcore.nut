// I HATE GOIGN TO WIKIPEDIA FOR THIS
// In the expression x = a ? b : c the variable x will be assigned the value b if a is true. Otherwise it will be assigned the value c.

/* PREFIX CONVENTIONS
g_ -> global
func -> function
ent_ -> entity handle
t_ -> table
str -> string
i -> integer
fl -> float
bool -> duh
vec[n] --> vector of the nth dimension
*/

// global roottables n shit
if (!("g_t_debugCreatedBrushes" in getroottable())) {
    ::g_t_debugCreatedBrushes <- {};
}
if (!("g_str_currentMap" in getroottable())) {
    ::g_str_currentMap <- "";
}

// if this doesnt work evil things will happen to the land of israel and palestine
if (!("g_bool_mapCheckRan" in getroottable())) {
	::g_bool_mapCheckRan <- true;

	::g_func_checkMap <- function() {
		local str_mapName = GetMapName();

		IncludeScript("verd/omori/dialogue_text.nut");
		printl("running default");
		if (str_mapName.find("ze_omori_") == 0) {
			printl("running omori specific scripts");
			IncludeScript("verd/omori/mapprint.nut");
            ::g_str_currentMap <- "omori";
		}
	}

	::g_func_checkMap();

}
// globals
::g_t_procAnimState <- {};
::g_func_debugShowBrushes <- function(str_name = null, fl_duration = 10.0) {
    function func_debugDrawBrush(t_brush) {
        switch (t_brush.str_brushType) {
            case (t_brush.str_brushType == "trigger") :
                DebugDrawBox(
                    t_brush.vec3_brushOrigin,
                    t_brush.vec3_brushMins,
                    t_brush.vec3_brushMaxs,
                    t_debugBrushColor.t_debugTrig.r, t_debugBrushColor.t_debugTrig.g, t_debugBrushColor.t_debugTrig.b, t_debugBrushColor.t_debugTrig.a,
                    fl_duration
                );
            case (t_brush.str_brushType == "button") :
                DebugDrawBox(
                    t_brush.vec3_brushOrigin,
                    t_brush.vec3_brushMins,
                    t_brush.vec3_brushMaxs,
                    t_debugBrushColor.t_debugButton.r, t_debugBrushColor.t_debugButton.g, t_debugBrushColor.t_debugButton.b, t_debugBrushColor.t_debugButton.a,
                    fl_duration
                );
        }
        if (t_brush.str_name != null) {
            DebugDrawText(
                t_brush.vec3_brushOrigin,
                str_name,
                false,
                fl_duration
            );
        }
    }
    if (str_name != null) {
        printl("show brushes not null");
        if (!(str_name in g_t_debugCreatedBrushes)) {
            printl("unknown created brush [" + str_name + "]");
            return;
        }
        func_debugDrawBrush(g_t_debugCreatedBrushes[str_name]);
        return;
    }
    else if (str_name == null) {
        printl("show brushes null");
        foreach (str_debugEntry, t_brush in ::g_t_debugCreatedBrushes) {
            func_debugDrawBrush(t_brush);
        }
    }
    else {
        printl("[debug] show brushes got a SECRET THIRD OPTION??? WHAT???");
    }
};

::g_func_getSteamID <- function(ent_player) {
	return NetProps.GetPropString(ent_player, "m_szNetworkIDString")
}

