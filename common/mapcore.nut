::g_t_coreEvents <- {
	OnGameEvent_player_spawn = function(t_params) {
		// SpawnFunction(t_params.userid)
	},

	OnGameEvent_player_say = function(t_params) {
		local ent_player = GetPlayerFromUserID(t_params.userid);
		// printl("player say");

		foreach (str_setting, t_setting in ::g_t_settingsFunctions) {
			if (t_params.text.tolower().find(str_setting) != null) {
				if (t_setting.bool_on == true) {
				t_setting.func_callback.call(getroottable(), ent_player);
				} else {
					printl(str_setting + " is off");
				}
			}
		}
	}
}
// what the fuck
__CollectGameEventCallbacks(::g_t_coreEvents);

::g_func_settingsState <- function(str_cmd, bool_state) {
	if (str_cmd in ::g_t_settingsFunctions) {
		::g_t_settingsFunctions[str_cmd].bool_on = bool_state;
	}
}

::g_func_getPlayerName <- function(ent_player) {
	if (ent_player == null || ent_player == "") { return "null value g_func_getPlayerName"; }

	return NetProps.GetPropString(ent_player, "m_szNetname");
}

::g_func_screenShakeTable <- function(t_shake) {
	ScreenShake(t_shake.center, t_shake.amplitude, t_shake.frequency, t_shake.duration, t_shake.radius, t_shake.command, t_shake.air_shake);
}

::g_func_spriteTable <- function(str_targetname = "unknown-entity", str_material = null, vec3_origin = null, str_out = "entity") {
	local t_spriteTable = {
        targetname = str_targetname,
		origin = (vec3_origin != null) ? vec3_origin.tostring() : Vector(0, 0, 0),
		model = (str_material != null) ? str_material : "verdessence/assets/omori/basil_test2.vmt",
		scale = 2,
		rendermode = 2,
	};
	if (str_out == "entity") { 
		SpawnEntityFromTable("env_sprite", t_spriteTable);
	}
	else if (str_out == "instance") {
		return t_spriteTable;
	}
	else {
		printl("unknown str_out value");
	};
}


::g_func_createBrush <- function(str_ent = "trigger_once", vec3_origin = null, t_options = {}) {
    local str_name              = ("str_name"      in t_options) ? t_options.str_name      : null;
    local i_size       = ("i_size"        in t_options) ? t_options.i_size        : 32;
    local ent_parent            = ("ent_parent"    in t_options) ? t_options.ent_parent    : null;
    local fl_wait        = ("fl_wait"       in t_options) ? t_options.fl_wait       : 0.01;
    local str_brushType = ("str_brushType" in t_options) ? t_options.str_brushType : "trigger";

    local t_brush = {
        targetname = str_name,
        origin = (vec3_origin != null) ? vec3_origin : Vector(0, 0, 0),
		spawnflags = 1,
    }
    if (ent_parent != null) {
        t_brush.angles <- ent_parent.GetAbsAngles();
        t_brush.parentname <- ent_parent.tostring();
    }
    if (str_ent == "trigger_multiple") {
        t_brush.wait <- fl_wait;
    }
	local ent_brush = SpawnEntityFromTable(str_ent, t_brush);
    if (ent_brush == null) {
        printl("dude. your ent_brush don exist. [" + str_ent + "]");
        return null;
    }
    local vec3_brushMins = Vector(-i_size, -i_size, -i_size);
    local vec3_brushMaxs = Vector(i_size, i_size, i_size);
    printl("i just made a " + str_ent);

	ent_brush.SetSolid(3);
	ent_brush.SetSize(vec3_brushMins, vec3_brushMaxs);
    ent_brush.ValidateScriptScope();

    local str_debugEntry = (str_name != null) ? str_name : ent_brush.entindex().tostring();
    g_t_debugCreatedBrushes[str_debugEntry] <- {
        ent_brush = ent_brush,
        str_name = str_name,
        vec3_brushMins = vec3_brushMins,
        vec3_brushMaxs = vec3_brushMaxs,
        vec3_brushOrigin = vec3_origin,
        str_brushType = str_brushType
    };
    return ent_brush;
}