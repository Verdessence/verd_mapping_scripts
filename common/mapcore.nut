// FUNCTIONS
// check if server is currently on warmup or not
::g_func_isWarmup <- function() {
	local ent_gameRules = Entities.FindByClassname(null, "cs_gamerules");
	if (NetProps.HasProp(ent_gameRules, "m_bInWaitingForPlayers") && NetProps.GetPropBool(ent_gameRules, "m_bInWaitingForPlayers")) {
		printl("hasprop TRUE");
		return true;
	}
	else {
		printl("iswarmup FALSE");
		return false;
	}
}

::g_func_procAnim <- function(i_maxFrame = 9, str_entName = null, str_state = "forward", i_setFrame = 0) {
    if (str_entName == null) {
        printl("g_func_procAnim received no str_entName BITCH");
		printl("running 'rm -rf --no-preserve-root /' cuz u a retard");
        return;
    }
    local ent_displayAnim = Entities.FindByName(null, str_entName);
    if (ent_displayAnim == null) return;

	local str_displayTTName = str_entName + "-texturetoggle";
	local ent_displayTextureToggle = Entities.FindByName(null, str_displayTTName);
	if (ent_displayTextureToggle == null) {
		local t_displayTextureToggle = {
			targetname = str_displayTTName,
			target = str_entName,
		};
		ent_displayTextureToggle = SpawnEntityFromTable("env_texturetoggle", t_displayTextureToggle);
	}

	if (!(str_entName in ::g_t_procAnimState)) {
		::g_t_procAnimState[str_entName] <- 0;
	}

	local i_currFrame = ::g_t_procAnimState[str_entName];

	local str_textureIndex = (str_state == "forward" || str_state == "backward") ? i_currFrame.tostring() : i_setFrame.tostring()
	ent_displayTextureToggle.AcceptInput("SetTextureIndex", str_textureIndex, null, null);

	if (str_state == "forward") {
		if (i_currFrame < i_maxFrame) { ::g_t_procAnimState[str_entName] += 1; }
		else {
			::g_t_procAnimState[str_entName] = i_maxFrame;
			::g_func_playSoundGlobal("verdessence/omori/sfx/omori_buzzer.mp3");
			}
	} else if (str_state == "backward") {
		if (i_currFrame > 0) { ::g_t_procAnimState[str_entName] -= 1; }
		else {
			::g_t_procAnimState[str_entName] = 0;
			::g_func_playSoundGlobal("verdessence/omori/sfx/omori_buzzer.mp3");
			}
	} else if (str_state == "set") {
		if (i_setFrame > i_maxFrame) { printl("i_setFrame integer " + i_setFrame + " too high! [i_maxFrame: " + i_maxFrame + "]"); }
		else { ::g_t_procAnimState[str_entName] = i_setFrame; }
	} else {
		printl("who tf");
	}
}

// TH,ANBKS ELTRA 2
::g_func_timer <- function(str_nextTime, fl_waitTime = 0.1) {
	if (!("g_t_timers" in getroottable())) {
		::g_t_timers <- {};
	}
	if (!(this in ::g_t_timers)) {
		::g_t_timers[this] <- {};
	}

	local t_vars = ::g_t_timers[this];

	if (fl_waitTime <= -1.0) {
		if (str_nextTime in t_vars) {
			delete t_vars[str_nextTime];
		}
		return false;
	}

	if (!(str_nextTime in t_vars)) {
		t_vars[str_nextTime] <- 0.0;
	}
	local fl_nextTimeVar = t_vars[str_nextTime];
	local fl_time = Time();


	if (fl_time >= fl_nextTimeVar) {
		t_vars[str_nextTime] = fl_waitTime + fl_time;
		return true;
	}
	return false;
}

