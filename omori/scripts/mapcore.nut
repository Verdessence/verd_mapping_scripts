::g_p_settingsFunctions <- {
	// shit from ze_omori
	"!test" : {
		on = true,
		callback = function(player) {
		// i dont know
		}
	},
	// h_wsInteractLaptop1
	"!stare" : {
		on = false,
		callback = function(player) {
			if (getSteamID(player) != ::g_str_laptopUser) {
				MapPrintAll("The laptop is already in use by " + ::g_str_laptopUser + ".");
			} else {
				h_procAnim(1, "ws-interact-laptop-display", "set", 0);
				MapPrintAll("You stared at the screen.");
			}
		}
	},
	"!openjournal" : {
		on = false,
		callback = function(player) {
			if (getSteamID(player) != ::g_str_laptopUser) {
				MapPrintAll("The laptop is already in use by " + ::g_str_laptopUser + ".");
			} else {
				printl("checking journal")
				h_procAnim(2, "ws-interact-laptop-display", "set", 1);
			}
		}
	},
}

// THANMS ELTRA 3.1
::h_coreEvents <- { 
	OnGameEvent_player_spawn = function(params) {
		// SpawnFunction(params.userid)
	},

	OnGameEvent_player_say = function(params) {
		local h_player = GetPlayerFromUserID(params.userid);
		// printl("player say");
		
		foreach (str_setting, p_function in g_p_settingsFunctions) {
			if (params.text.tolower().find(str_setting) != null) {
				if (p_function.on == true) {
				p_function.callback.call(this, h_player);
				} else {
					printl(str_setting + " is off");
				}
			}
		}
	}
}

// what the fuck
__CollectGameEventCallbacks(h_coreEvents);
__CollectGameEventCallbacks(g_p_checkMap);

::settingsState <- function(str_cmd, bool_state) {
	if (str_cmd in g_p_settingsFunctions) {
		g_p_settingsFunctions[str_cmd].on = bool_state;
	}
}