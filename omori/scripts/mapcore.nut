	OnGameEvent_game_newmap = function(params) {
		if (params.mapname.find("ze_omori_") == 0) {
			IncludeScript("verd/omori/stages/prologue.nut");
			IncludeScript("verd/omori/stages/mapprint.nut");
		}
	}
}
::getSteamID <- function(player) {
	return NetProps.GetPropString(player, "m_szNetworkIDString")
}

