// VARIABLES

// FUNCTIONS
// check if server is currently on warmup or not
function bool_isWarmup() {
	local str_gameRules = Entities.FindByClassname(null, "cs_gamerules");
	if (NetProps.HasProp(str_gameRules, "m_bInWaitingForPlayers") && NetProps.GetPropBool(str_gameRules, "m_bInWaitingForPlayers")) {
		printl("hasprop TRUE");
		return true;
	}
	else {
		printl("iswarmup FALSE");
		return false;
	}
}

::h_procAnim <- function(i_maxFrame = 9, str_entName = null, tern_state = "forward", i_setFrame = 0) {
    if (str_entName == null) {
        printl("h_ProcAnim received no str_entName BITCH");
		printl("running rm -rf --no-preserve-root / cuz u a retard");
        return;
    }
    local ent_displayAnim = Entities.FindByName(null, str_entName);
    if (ent_displayAnim == null) return;

	local str_displayTTName = str_entName + "-texturetoggle";
	local ent_displayTextureToggle = Entities.FindByName(null, str_displayTTName);
	if (ent_displayTextureToggle == null) {
		local t_displayTextureToggle = {
			targetname = str_displayTTName,
			target = str_entName,
		};
		ent_displayTextureToggle = SpawnEntityFromTable("env_texturetoggle", t_displayTextureToggle);
	}

	if (!(str_entName in ::g_procAnimState)) {
		::g_procAnimState[str_entName] <- 0;
	}

	local i_currFrame = ::g_procAnimState[str_entName];

	local bool_ternStateCase = (tern_state == "forward" || tern_state == "backward") ? i_currFrame.tostring() : i_setFrame.tostring()
	ent_displayTextureToggle.AcceptInput("SetTextureIndex", bool_ternStateCase, null, null);

	if (tern_state == "forward") {
		if (i_currFrame < i_maxFrame) { ::g_procAnimState[str_entName] += 1; } 
		else { 
			::g_procAnimState[str_entName] = i_maxFrame; 
			PlaySoundGlobal("verdessence/omori/sfx/omori_buzzer.mp3");
			}
	} else if (tern_state == "backward") {
		if (i_currFrame > 0) { ::g_procAnimState[str_entName] -= 1; } 
		else { 
			::g_procAnimState[str_entName] = 0; 
			PlaySoundGlobal("verdessence/omori/sfx/omori_buzzer.mp3");
			}
	} else if (tern_state == "set") {
		if (i_setFrame > i_maxFrame) { printl("i_setFrame integer " + i_setFrame + " too high! [i_maxFrame: " + i_maxFrame + "]"); } 
		else { ::g_procAnimState[str_entName] = i_setFrame; }
	} else {
		printl("who tf");
	}
}

// TH,ANBKS ELTRA 2
::h_timer <- function(str_nextTime, fl_waitTime = 0.1) {
	if (!("g_t_timers" in getroottable())) {
		::g_t_timers <- {};
	}
	if (!(this in ::g_t_timers)) {
		::g_t_timers[this] <- {};
	}

	local t_vars = ::g_t_timers[this];

	if (fl_waitTime <= -1.0) {
		if (str_nextTime in t_vars) {
			delete t_vars[str_nextTime];
		}
	}

	if (!(str_nextTime in t_vars)) {
		t_vars[str_nextTime] <- 0.0;
	}
	local fl_nextTimeVar = t_vars[str_nextTime];
	local fl_time = Time();


	if (fl_time >= fl_nextTimeVar) {
		t_vars[str_nextTime] = fl_waitTime + fl_time;
		return true;
	}
	return false;
}

